# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Sent by Telegram on every webhook request (X-Telegram-Bot-Api-Secret-Token);
# generate a random string, e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Separate from the webhook secret: required to call /api/telegram/setup,
# which (re)configures Telegram's webhook. Generate independently, e.g.
# `openssl rand -hex 32`.
TELEGRAM_SETUP_SECRET=

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
ALLOWED_TELEGRAM_USER_IDS=

# --- Content source ---
# "local" for development against a filesystem folder, "github" for production.
CONTENT_PROVIDER=local

# Used only when CONTENT_PROVIDER=local.
CONTENT_ROOT=C:\Users\antonio\Desktop\mastery

# --- GitHub content provider (used only when CONTENT_PROVIDER=github) ---
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
# Path inside the repository where the knowledge base lives. Use an empty
# string if the content sits at the repository root.
GITHUB_CONTENT_PATH=

# Read-only for browsing/search/ask. If EDITORS below is set, this token also
# needs "Contents: write" permission on the content repo, since /save commits
# to it directly.
GITHUB_TOKEN=

# --- /ask (RAG chat) ---
# Free at https://console.groq.com/keys — powers the LLM answer for any plain
# text message the bot receives.
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# --- /save (chat-driven authoring) ---
# Comma-separated <telegram-user-id>:<folder-name> pairs. Each editor's /save
# writes are confined to their own top-level folder in the content repo.
# Optional; /save is inactive entirely if left empty.
EDITORS=

# --- read visibility ---
# Comma-separated <folder-name>:<telegram-user-id> pairs. A listed top-level
# folder is only shown to (and readable by, via browse/search/ask) its owner
# — everyone else sees it as if it doesn't exist. Independent of EDITORS: a
# folder can be private without being anyone's /save target, or vice versa.
# Optional; nothing is restricted if left empty.
PRIVATE_FOLDERS=
