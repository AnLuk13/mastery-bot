# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Sent by Telegram on every webhook request (X-Telegram-Bot-Api-Secret-Token);
# generate a random string, e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Separate from the webhook secret: required to call /api/telegram/setup,
# which (re)configures Telegram's webhook. Generate independently, e.g.
# `openssl rand -hex 32`.
TELEGRAM_SETUP_SECRET=

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
ALLOWED_TELEGRAM_USER_IDS=

# --- Content source ---
# "local" for development against a filesystem folder, "github" for production.
CONTENT_PROVIDER=local

# Used only when CONTENT_PROVIDER=local.
CONTENT_ROOT=C:\Users\antonio\Desktop\mastery

# --- GitHub content provider (used only when CONTENT_PROVIDER=github) ---
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
# Path inside the repository where the knowledge base lives. Use an empty
# string if the content sits at the repository root.
GITHUB_CONTENT_PATH=

# Read-only for browsing/search/ask. If EDITORS below is set, this token also
# needs "Contents: write" permission on the content repo, since /save commits
# to it directly, AND "Actions: write" permission on THIS repo (mastery-bot,
# or whatever BOT_REPOSITORY is set to below), since a successful /save
# triggers a reindex via the Actions API instead of that workflow polling on
# a cron — see .github/workflows/reindex.yml.
GITHUB_TOKEN=

# This app's own repo name, under the same owner as GITHUB_OWNER above — only
# used to trigger reindex.yml after a /save write. Optional; defaults to
# "mastery-bot".
BOT_REPOSITORY=

# --- /ask (RAG chat) ---
# Free at https://console.groq.com/keys — powers the LLM answer for any plain
# text message the bot receives.
GROQ_API_KEY=
# Used by /save's structured decisions. Optional; defaults to openai/gpt-oss-120b.
GROQ_MODEL=
# Used by /ask. Optional; defaults to groq/compound-mini, an agentic model
# with live web search built in (no separate search API needed). Compound
# models don't support reasoning_effort or structured JSON output, which is
# why this is a separate setting from GROQ_MODEL above.
GROQ_ASK_MODEL=
# A second, distinct compound model tried before /ask gives up live web
# search entirely — Groq tracks each model's daily request cap independently,
# so this is a genuinely separate quota, not a relabeled retry of the same
# one. Optional; defaults to groq/compound.
GROQ_ASK_FALLBACK_MODEL=

# --- /save (chat-driven authoring) ---
# Comma-separated <telegram-user-id>:<folder-name> pairs. Each editor's /save
# writes are confined to their own top-level folder in the content repo.
# Optional; /save is inactive entirely if left empty.
EDITORS=

# --- /admin (manage allowed users at runtime) ---
# Comma-separated Telegram numeric user IDs allowed to use /admin to
# add/remove entries from the allowed-user list without a redeploy. Requires
# KV_REST_API_URL/KV_REST_API_TOKEN below (dynamic additions are stored in
# Redis; ALLOWED_TELEGRAM_USER_IDS above stays the immutable base list).
# Optional; /admin is inactive entirely if left empty.
BOT_ADMIN_IDS=

# --- read visibility ---
# Comma-separated <folder-name>:<telegram-user-id> pairs. A listed top-level
# folder is only shown to (and readable by, via browse/search/ask) its owner
# — everyone else sees it as if it doesn't exist. Independent of EDITORS: a
# folder can be private without being anyone's /save target, or vice versa.
# Optional; nothing is restricted if left empty.
PRIVATE_FOLDERS=

# --- ambient /ask session memory ---
# Both optional together: add Vercel's "Upstash for Redis" marketplace
# integration (or point these at any Upstash Redis instance's REST
# credentials) to make plain follow-up questions remember the conversation
# and the last document you viewed, with no need to reply. Left unset, /ask
# just answers each message fresh with no memory. Names match what Vercel's
# integration actually injects (KV_REST_API_*), not Upstash's own
# UPSTASH_REDIS_REST_* naming.
KV_REST_API_URL=
KV_REST_API_TOKEN=
